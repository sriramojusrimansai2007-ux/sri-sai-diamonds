# =========================================================
# SRI SAI DIAMONDS & TOOLS — BACKEND CONFIGURATION
# =========================================================

# 1. CapsGold Official B2B API Credentials (Server-Side Only)
# Enter the official API Key provided under your CapsGold dealer contract.
# NEVER expose this key in client-side HTML, CSS, or JS!
CAPSGOLD_API_KEY=

# Official CapsGold API Endpoint (or authorized dealer proxy URL)
CAPSGOLD_API_URL=

# 2. Configurable Business Rate Adjustments (in INR)
# Our Gold Rate = CapsGold Gold Rate + ₹400 per 10 grams (+₹40/g)
GOLD_ADJUSTMENT_PER_10G=400

# Our Silver Rate = CapsGold Silver Rate + ₹25 per 10 grams (+₹2.50/g, +₹2500/kg)
SILVER_ADJUSTMENT_PER_10G=25

# 3. Server Configuration
PORT=8000
NODE_ENV=production

